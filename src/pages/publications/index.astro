---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { ExternalLink, FileText, Calendar } from '@lucide/astro';

const publications = await getCollection('publications');
const sortedPublications = publications.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<BaseLayout
  title="Publications & Specs | Yashasav"
  description="Research publications, technical specifications, and open-source architecture specs by Yashasav."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-8">
    
    <div class="space-y-3">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 text-xs font-mono border border-neutral-200 dark:border-neutral-800">
        <FileText class="w-3.5 h-3.5 text-neutral-500" />
        <span>Research & Open Specs</span>
      </div>
      <h1 class="text-3xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
        Publications & Technical Reports
      </h1>
      <p class="text-neutral-600 dark:text-neutral-400 text-sm max-w-2xl leading-relaxed">
        Academic conference papers, technical reports, and open-source RFC specifications on heterogeneous cluster serving, speculative decoding, and CUDA memory architecture.
      </p>
    </div>

    <!-- Publications List -->
    <div class="space-y-4">
      {sortedPublications.map((pub) => (
        <div class="p-5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-card-light dark:bg-card-dark space-y-3">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded-sm text-xs font-mono font-medium bg-neutral-100 dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-800">
              {pub.data.venue}
            </span>
            <span class="text-xs font-mono text-neutral-500 flex items-center gap-1">
              <Calendar class="w-3.5 h-3.5" />
              {pub.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric' })}
            </span>
          </div>

          <h2 class="text-lg font-bold text-neutral-900 dark:text-white leading-snug">
            {pub.data.title}
          </h2>

          <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-300 leading-relaxed">
            {pub.data.abstract}
          </p>

          <div class="flex flex-wrap items-center justify-between gap-4 pt-2 border-t border-neutral-100 dark:border-neutral-900">
            <div class="flex items-center gap-1.5 text-[11px] font-mono text-neutral-500">
              {pub.data.tags.map((tag) => (
                <span class="px-1.5 py-0.5 rounded-sm bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400 border border-neutral-200 dark:border-neutral-800">
                  #{tag}
                </span>
              ))}
            </div>

            {pub.data.paperUrl && (
              <a
                href={pub.data.paperUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 text-xs font-medium transition-colors"
              >
                <span>Read Paper</span>
                <ExternalLink class="w-3.5 h-3.5" />
              </a>
            )}
          </div>
        </div>
      ))}
    </div>

  </div>
</BaseLayout>
