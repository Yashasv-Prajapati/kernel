---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { Mail, ArrowRight, BookOpen, Server, Calendar, Clock, Tag } from '@lucide/astro';

const allPosts = await getCollection('posts', ({ data }) => !data.draft);
const featuredPosts = allPosts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const publications = await getCollection('publications');
const sortedPublications = publications
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

// Collect unique tags
const allTags = Array.from(new Set(allPosts.flatMap((post) => post.data.tags)));
---

<BaseLayout
  title="Yashasav | Inference Engines & Distributed Systems Engineer"
  description="Personal portfolio and technical blog of Yashasav — LLM Inference Engines, Distributed Systems, Apache Kafka, and High-Throughput systems."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 sm:py-16 space-y-14">
    
    <!-- Hero Header Section - Clean & Authoritative -->
    <section class="flex flex-col md:flex-row items-start md:items-center gap-8 justify-between">
      <div class="space-y-4 max-w-2xl">
        <div class="inline-flex items-center gap-2 px-2.5 py-1 rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 text-xs font-mono border border-neutral-200 dark:border-neutral-800">
          <span>Inference Engines and optimizations • Distributed Systems • High throughput systems</span>
        </div>

        <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
          Yashasav
        </h1>

        <p class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed font-normal">
          Building LLM inference serving runtimes, high-throughput distributed systems with Apache Kafka, and resilient platform infrastructure. Experienced in architecting inventory operations and database scaling.
        </p>

        <!-- Social Icons Bar - Sharp Buttons -->
        <div class="flex items-center gap-2 pt-1">
          <a
            href="https://github.com/Yashasv-Prajapati"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 text-xs font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
            </svg>
            <span>GitHub</span>
          </a>
          <a
            href="https://x.com/infra_engineer4"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 text-xs font-medium hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
          >
            <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
              <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
            </svg>
            <span>X (Twitter)</span>
          </a>
          <a
            href="mailto:yamuprajapati@gmail.com"
            class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-md bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 text-xs font-medium hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
          >
            <Mail class="w-3.5 h-3.5" />
            <span>Email</span>
          </a>
        </div>
      </div>

      <!-- Clean Profile Card -->
      <div class="shrink-0">
        <div class="w-32 h-32 sm:w-36 sm:h-36 rounded-md bg-card-light dark:bg-card-dark border border-neutral-200 dark:border-neutral-800 p-3 flex flex-col items-center justify-center text-center">
          <Server class="w-8 h-8 text-neutral-700 dark:text-neutral-300 mb-1.5" />
          <span class="font-mono text-xs font-bold text-neutral-900 dark:text-white">Yashasav</span>
          <span class="text-[11px] text-neutral-500 font-mono">@systems_eng</span>
        </div>
      </div>
    </section>

    <hr class="border-neutral-200 dark:border-neutral-800" />

    <!-- My Journey & Focus -->
    <section class="space-y-3">
      <div class="flex items-center gap-2 text-xs font-mono font-semibold uppercase tracking-wider text-neutral-500 dark:text-neutral-400">
        <BookOpen class="w-3.5 h-3.5" />
        <span>Engineering Focus</span>
      </div>
      <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
        High-Throughput Systems & LLM Serving
      </h2>
      <div class="prose dark:prose-invert max-w-none text-neutral-600 dark:text-neutral-300 leading-relaxed text-sm">
        <p>
          My technical focus spans <strong>LLM inference engines</strong> (PagedAttention & RadixAttention memory optimizations) alongside <strong>large-scale distributed systems</strong>.
        </p>
        <p>
          Having engineered high-throughput event pipelines for inventory management (at Blinkit), I write technical breakdowns on Kafka log segment internals, zero-copy I/O, consumer lag, and database state synchronization.
        </p>
      </div>
    </section>

    <!-- Topics / Tags Overview -->
    <section class="space-y-3">
      <h3 class="text-xs font-mono uppercase tracking-wider text-neutral-500 dark:text-neutral-400 font-semibold">
        Topics
      </h3>
      <div class="flex flex-wrap gap-1.5">
        {allTags.map((tag) => (
          <a
            href={`/blog?tag=${tag}`}
            class="px-2.5 py-1 rounded-sm text-xs font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 border border-neutral-200 dark:border-neutral-800 hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors flex items-center gap-1"
          >
            <Tag class="w-3 h-3 text-neutral-400" />
            <span>#{tag}</span>
          </a>
        ))}
      </div>
    </section>

    <!-- Featured Writings Grid -->
    <section class="space-y-5">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
          Flagship Writings
        </h2>
        <a
          href="/blog"
          class="flex items-center gap-1 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <span>All articles</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        {featuredPosts.map((post) => (
          <article class="group relative flex flex-col justify-between p-5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-card-light dark:bg-card-dark hover:border-neutral-400 dark:hover:border-neutral-600 transition-colors">
            <div class="space-y-2.5">
              <div class="flex items-center gap-2 text-xs text-neutral-500 font-mono">
                <span class="flex items-center gap-1">
                  <Calendar class="w-3.5 h-3.5" />
                  {post.data.pubDate.toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' })}
                </span>
                <span>•</span>
                {post.data.readingTime && (
                  <span class="flex items-center gap-1">
                    <Clock class="w-3.5 h-3.5" />
                    {post.data.readingTime}
                  </span>
                )}
              </div>

              <h3 class="text-base font-bold text-neutral-900 dark:text-white group-hover:text-blue-600 dark:group-hover:text-blue-400 transition-colors leading-snug">
                <a href={`/posts/${post.id}`}>
                  <span class="absolute inset-0"></span>
                  {post.data.title}
                </a>
              </h3>

              <p class="text-xs text-neutral-600 dark:text-neutral-400 line-clamp-3 leading-relaxed">
                {post.data.description}
              </p>
            </div>

            <div class="flex items-center gap-1.5 pt-4 mt-3 border-t border-neutral-100 dark:border-neutral-900 text-[11px] font-mono text-neutral-500">
              {post.data.tags.slice(0, 3).map((tag) => (
                <span class="px-1.5 py-0.5 rounded-sm bg-neutral-100 dark:bg-neutral-900 text-neutral-600 dark:text-neutral-400">
                  #{tag}
                </span>
              ))}
            </div>
          </article>
        ))}
      </div>
    </section>

    <!-- Publications & Research Section -->
    <section class="space-y-5">
      <div class="flex items-center justify-between">
        <h2 class="text-xl font-bold tracking-tight text-neutral-900 dark:text-white">
          Publications & Research
        </h2>
        <a
          href="/publications"
          class="flex items-center gap-1 text-xs font-mono text-neutral-500 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <span>View all</span>
          <ArrowRight class="w-3.5 h-3.5" />
        </a>
      </div>

      <div class="space-y-3">
        {sortedPublications.map((pub) => (
          <div class="p-5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-card-light dark:bg-card-dark space-y-2.5">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1.5">
              <span class="inline-flex items-center px-2 py-0.5 rounded-sm text-xs font-mono bg-neutral-100 dark:bg-neutral-900 text-neutral-800 dark:text-neutral-200 border border-neutral-200 dark:border-neutral-800">
                {pub.data.venue}
              </span>
              <span class="text-xs font-mono text-neutral-500">
                {pub.data.pubDate.toLocaleDateString('en-US', { month: 'short', year: 'numeric' })}
              </span>
            </div>

            <h3 class="text-base font-bold text-neutral-900 dark:text-white">
              {pub.data.title}
            </h3>

            <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed">
              {pub.data.abstract}
            </p>

            {pub.data.link && (
              <div class="pt-1">
                <a
                  href={pub.data.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1 text-xs font-mono text-blue-600 dark:text-blue-400 hover:underline"
                >
                  <span>IEEE Explore</span>
                  <svg class="w-3 h-3 stroke-current fill-none" viewBox="0 0 24 24" stroke-width="2">
                    <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path>
                    <polyline points="15 3 21 3 21 9"></polyline>
                    <line x1="10" y1="14" x2="21" y2="3"></line>
                  </svg>
                </a>
              </div>
            )}
          </div>
        ))}
      </div>
    </section>

  </div>
</BaseLayout>
