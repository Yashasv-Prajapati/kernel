---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Terminal, Code, Server, Database, Mail } from '@lucide/astro';
---

<BaseLayout
  title="About Me | Yashasav"
  description="Background narrative, engineering focus on LLM inference engines, Apache Kafka, distributed systems, and databases."
>
  <div class="max-w-4xl mx-auto px-4 sm:px-6 py-12 space-y-10">
    
    <!-- Hero Title -->
    <div class="space-y-3">
      <div class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded bg-neutral-100 dark:bg-neutral-900 text-neutral-700 dark:text-neutral-300 text-xs font-mono border border-neutral-200 dark:border-neutral-800">
        <Terminal class="w-3.5 h-3.5 text-neutral-500" />
        <span>Inference Engines & Distributed Systems</span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-extrabold tracking-tight text-neutral-900 dark:text-white">
        About & Technical Journey
      </h1>
      <p class="text-base text-neutral-600 dark:text-neutral-300 leading-relaxed max-w-2xl">
        Software engineer focused on LLM inference engine architectures, high-throughput event streaming with Apache Kafka, distributed systems, and platform infrastructure.
      </p>
    </div>

    <hr class="border-neutral-200 dark:border-neutral-800" />

    <!-- Narrative Section -->
    <section class="prose dark:prose-invert max-w-none text-neutral-700 dark:text-neutral-300 space-y-5 leading-relaxed text-sm sm:text-base">
      <h2 class="text-xl font-bold text-neutral-900 dark:text-white">Engineering Focus & Experience</h2>
      <p>
        My work spans <b>LLM inference engines</b> and <b>high-scale distributed systems software</b>:
      </p>

      <ul class="space-y-1.5 list-disc pl-5">
        <li><strong>LLM Inference Engines:</strong> Researching and evaluating runtime memory allocation strategies—comparing OS-style virtual page block tables (PagedAttention in vLLM) against dynamic prefix tree caching (RadixAttention in SGLang). Evaluating and trying different LLM inference optimization techniques like speculative decoding, prefill chunking, prefill-decode disaggregation, etc.</li>
        <li><strong>Distributed Event Streaming (Kafka):</strong> Designing event-driven architectures, partition key strategies, log segment tuning, zero-copy kernel transfers, and managing consumer lag in high-throughput applications.</li>
        <li><strong>High throughput Inventory Systems:</strong> Building low-latency, resilient inventory state transitions and store fulfillment pipelines (working on Blinkit's dark store operations).</li>
        <li><strong>Databases & Platform Engineering:</strong> Managing ACID storage engines, relational database scaling, indexing strategies, and platform developer infrastructure.</li>
      </ul>

      <h2 class="text-xl font-bold text-neutral-900 dark:text-white pt-3">Technical Stack & Toolkit</h2>
    </section>

    <!-- Stack Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-3">
      <div class="p-4 rounded-md border border-neutral-200 dark:border-neutral-800 bg-card-light dark:bg-card-dark space-y-1.5">
        <Server class="w-5 h-5 text-neutral-700 dark:text-neutral-300" />
        <h3 class="font-bold text-xs sm:text-sm text-neutral-900 dark:text-white">Inference & Runtimes</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed font-mono">
          vLLM, SGLang, PagedAttention, Prefix Caching, Speculative Decoding.
        </p>
      </div>

      <div class="p-4 rounded-md border border-neutral-200 dark:border-neutral-800 bg-card-light dark:bg-card-dark space-y-1.5">
        <Database class="w-5 h-5 text-neutral-700 dark:text-neutral-300" />
        <h3 class="font-bold text-xs sm:text-sm text-neutral-900 dark:text-white">Distributed & Kafka</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed font-mono">
          Apache Kafka, Event-Driven Architecture, Log Compaction, Consumer Lag, RocksDB.
        </p>
      </div>

      <div class="p-4 rounded-md border border-neutral-200 dark:border-neutral-800 bg-card-light dark:bg-card-dark space-y-1.5">
        <Code class="w-5 h-5 text-neutral-700 dark:text-neutral-300" />
        <h3 class="font-bold text-xs sm:text-sm text-neutral-900 dark:text-white">Databases & Platform</h3>
        <p class="text-xs text-neutral-600 dark:text-neutral-400 leading-relaxed font-mono">
          PostgreSQL, Redis, Microservices, Inventory management, Infrastructure.
        </p>
      </div>
    </div>

    <!-- Contact & Connect Card -->
    <section class="p-5 rounded-md border border-neutral-200 dark:border-neutral-800 bg-neutral-100/50 dark:bg-neutral-900/50 space-y-3">
      <h3 class="text-base font-bold text-neutral-900 dark:text-white">Connect & Collaborate</h3>
      <p class="text-xs sm:text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Always open to discussing LLM serving engines, Kafka streaming pipelines, distributed systems architecture, or software engineering in general.
      </p>
      <div class="flex flex-wrap gap-2">
        <a
          href="https://github.com/Yashasv-Prajapati"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-900 dark:bg-neutral-100 text-white dark:text-neutral-900 text-xs font-medium hover:bg-neutral-800 dark:hover:bg-neutral-200 transition-colors"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0024 12c0-6.63-5.37-12-12-12z"/>
          </svg>
          <span>GitHub</span>
        </a>
        <a
          href="https://x.com/infra_engineer4"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 text-xs font-medium hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
        >
          <svg class="w-3.5 h-3.5 fill-current" viewBox="0 0 24 24">
            <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
          </svg>
          <span>X (Twitter)</span>
        </a>
        <a
          href="mailto:yamuprajapati@gmail.com"
          class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-md bg-neutral-100 dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 text-neutral-800 dark:text-neutral-200 text-xs font-medium hover:bg-neutral-200 dark:hover:bg-neutral-800 transition-colors"
        >
          <Mail class="w-3.5 h-3.5" />
          <span>Email</span>
        </a>
      </div>
    </section>

  </div>
</BaseLayout>
